<Window x:Class="HotSonos.App.PhonePairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone"
        Width="560" Height="640"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF4F6F8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24">
            <TextBlock Text="Phone" FontSize="26" FontWeight="SemiBold" Foreground="#FF1C2536" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#FF60707F" Margin="0,4,0,12" />

            <TextBlock Text="Type these on the phone" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border Background="White" BorderBrush="#FFD8DEE4" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="Address" Foreground="#FF60707F" />
                    <DockPanel Margin="0,2,0,10">
                        <Button DockPanel.Dock="Right" Content="Copy" Margin="12,0,0,0" Padding="10,4" Click="CopyAddress_Click" />
                        <TextBox x:Name="HostText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="Port" Foreground="#FF60707F" />
                    <TextBox x:Name="PortText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontSize="22" FontWeight="SemiBold" Margin="0,2,0,10" />
                    <TextBlock Text="PIN" Foreground="#FF60707F" />
                    <DockPanel Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right" Content="Copy" Margin="12,0,0,0" Padding="10,4" VerticalAlignment="Center" Click="CopyPin_Click" />
                        <TextBox x:Name="PinText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontSize="32" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#FF1C8E54" />
                    </DockPanel>
                    <Button Content="New PIN" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4" Click="NewPin_Click" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="UrlText" TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,8,0,0" />
            <TextBlock x:Name="OtherAddressesText" TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,6,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,8,0,0"
                       Text="The phone sends this PIN on every request. The listener stays on the PC address that shares a network with a speaker. An Android emulator must use that 192.168 address. 10.0.2.2 is the PC loopback, and HotSonos does not listen there. MCP stays on 127.0.0.1." />

            <TextBlock Text="Windows Firewall" FontWeight="SemiBold" Margin="0,18,0,6" />
            <TextBlock TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,0,0,8"
                       Text="A phone on Wi-Fi needs inbound TCP for the remote, and UDP so the phone can find this PC. Private networks only. HotSonos does not change Public. From an elevated PowerShell, or use the button:" />
            <TextBox x:Name="FirewallText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="8" />
            <Button Content="Allow on private networks…" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Padding="10,4" Click="Firewall_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
