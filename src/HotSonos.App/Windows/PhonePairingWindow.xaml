<Window x:Class="HotSonos.App.PhonePairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone"
        Width="560" Height="860"
        MinWidth="420" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF4F6F8">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,18,24,24">
            <TextBlock Text="Phone" FontSize="26" FontWeight="SemiBold" Foreground="#FF1C2536" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#FF60707F" Margin="0,4,0,12" />

            <TextBlock Text="Scan this on the phone" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border x:Name="QrBorder" Background="White" BorderBrush="#FFD8DEE4" BorderThickness="1" CornerRadius="8"
                    Padding="12" HorizontalAlignment="Left" Visibility="Collapsed">
                <Image x:Name="QrImage" Width="220" Height="220" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <TextBlock x:Name="QrHint" TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,8,0,4" />
            <Button x:Name="CopyLinkButton" Content="Copy link" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Padding="10,4" Visibility="Collapsed" Click="CopyLink_Click" />

            <TextBlock Text="Type these on the phone" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border Background="White" BorderBrush="#FFD8DEE4" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="Address" Foreground="#FF60707F" />
                    <DockPanel Margin="0,2,0,10">
                        <Button DockPanel.Dock="Right" Content="Copy" Margin="12,0,0,0" Padding="10,4" Click="CopyAddress_Click" />
                        <TextBox x:Name="HostText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="Port" Foreground="#FF60707F" />
                    <TextBox x:Name="PortText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontSize="22" FontWeight="SemiBold" Margin="0,2,0,10" />
                    <TextBlock Text="PIN" Foreground="#FF60707F" />
                    <DockPanel Margin="0,2,0,0">
                        <Button DockPanel.Dock="Right" Content="Copy" Margin="12,0,0,0" Padding="10,4" VerticalAlignment="Center" Click="CopyPin_Click" />
                        <TextBox x:Name="PinText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 FontSize="32" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#FF1C8E54" />
                    </DockPanel>
                    <Button Content="New PIN" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4" Click="NewPin_Click" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="UrlText" TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,8,0,0" />
            <TextBlock x:Name="OtherAddressesText" TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,6,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,8,0,0"
                       Text="The phone sends this PIN on every request. The listener stays on the PC address that shares a network with a speaker. An Android emulator must use that 192.168 address. 10.0.2.2 is the PC loopback, and HotSonos does not listen there. MCP stays on 127.0.0.1." />

            <TextBlock Text="Pairing password" FontWeight="SemiBold" Margin="0,18,0,6" />
            <TextBlock TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,0,0,8"
                       Text="The phone can pair with this when you are not at the PC. Changing it signs every phone out." />
            <Border Background="White" BorderBrush="#FFD8DEE4" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="New password" Foreground="#FF60707F" />
                    <PasswordBox x:Name="PairPasswordBox" Margin="0,2,0,10" Padding="6,4" />
                    <TextBlock Text="Confirm" Foreground="#FF60707F" />
                    <PasswordBox x:Name="PairPasswordConfirmBox" Margin="0,2,0,10" Padding="6,4" />
                    <Button x:Name="ChangePairPasswordButton" Content="Change password" HorizontalAlignment="Left"
                            Padding="10,4" Click="ChangePairPassword_Click" />
                    <TextBlock x:Name="PairPasswordStatus" TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Windows Firewall" FontWeight="SemiBold" Margin="0,18,0,6" />
            <TextBlock TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,0,0,8"
                       Text="A phone on Wi-Fi needs inbound TCP for the remote, and UDP so the phone can find this PC. Private networks only. HotSonos does not change Public. From an elevated PowerShell, or use the button:" />
            <TextBox x:Name="FirewallText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="8" />
            <Button Content="Allow on private networks…" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Padding="10,4" Click="Firewall_Click" />

            <TextBlock Text="Phone wireless debugging" FontWeight="SemiBold" Margin="0,18,0,6" />
            <TextBlock TextWrapping="Wrap" Foreground="#FF60707F" FontSize="12" Margin="0,0,0,8"
                       Text="Install and debug the phone app over Wi-Fi. This is Android wireless debugging, separate from the HotSonos PIN above. The connect port changes when the phone reboots. Pairing is optional. The pairing code is shown on the phone once and is not saved." />
            <Border Background="White" BorderBrush="#FFD8DEE4" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="Phone adb IP" Foreground="#FF60707F" />
                    <TextBox x:Name="AdbHostBox" Margin="0,2,0,10" Padding="6,4" />
                    <TextBlock Text="Connect port" Foreground="#FF60707F" />
                    <TextBox x:Name="AdbConnectPortBox" Margin="0,2,0,10" Padding="6,4" />

                    <TextBlock Text="Pairing" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <TextBlock Text="Pairing port" Foreground="#FF60707F" />
                    <TextBox x:Name="AdbPairPortBox" Margin="0,2,0,10" Padding="6,4" />
                    <TextBlock Text="Pairing code" Foreground="#FF60707F" />
                    <TextBox x:Name="AdbPairCodeBox" Margin="0,2,0,10" Padding="6,4" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="AdbPairButton" Content="Pair" Padding="14,4" Margin="0,0,8,0" Click="AdbPair_Click" />
                        <Button x:Name="AdbConnectButton" Content="Connect" Padding="14,4" Click="AdbConnect_Click" />
                    </StackPanel>
                    <TextBox x:Name="AdbResultText" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="8"
                             Margin="0,10,0,0" MinHeight="48" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto" Foreground="#FF1C2536" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
