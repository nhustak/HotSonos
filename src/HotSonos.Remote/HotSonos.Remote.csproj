<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Android is the default so Windows and Linux builds (GitHub Actions) do not
         need the iOS workload. macOS also targets net10.0-ios.
         Codemagic passes -p:HotSonosRemoteTargetFrameworks=net10.0-ios so restore
         does not also pull the Android workload. That property is local to this
         project: a global TargetFrameworks would retarget HotSonos.Remote.Protocol
         and HotSonos.Core, which stay net10.0. -->
    <TargetFrameworks Condition="'$(HotSonosRemoteTargetFrameworks)' != ''">$(HotSonosRemoteTargetFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="'$(HotSonosRemoteTargetFrameworks)' == '' And '$(TargetFrameworks)' == ''">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(HotSonosRemoteTargetFrameworks)' == '' And '$(TargetFrameworks)' == 'net10.0-android' And ($([MSBuild]::IsOSPlatform('OSX')) Or '$(IncludeiOS)' == 'true')">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>HotSonos.Remote</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>HotSonos</ApplicationTitle>
    <!-- Android package and iOS bundle id. An install of the previous id,
         com.hotsonos.remote, is a different app and is not replaced.
         Saved pairing (address, port, PIN) stays across updates of this id
         and is wiped if the id changes. -->
    <ApplicationId>com.tangenttech.hotsonos</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>4</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

    <!-- Debug APK keeps the assemblies inside so adb install works without Fast Deployment. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <!-- iOS. CodesignKey defaults to a local development identity. Codemagic passes
       -p:CodesignKey and -p:CodesignProvision for App Store distribution.
       An empty -p:CodesignKey is a global property and wins over this default,
       which is how the unsigned simulator check builds.
       Apple rejects the four-part product version (1.0.0.76). The store version
       is 1.0.76 unless the publish command passes ApplicationDisplayVersion. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <ApplicationDisplayVersion>1.0.76</ApplicationDisplayVersion>
    <CodesignKey Condition="'$(CodesignKey)' == ''">Apple Development</CodesignKey>
    <CodesignEntitlements>Platforms\iOS\Entitlements.plist</CodesignEntitlements>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>

  <!-- Play upload signing (Release only). Keystore lives outside the repo,
       by default in %USERPROFILE%\.android-keys\hotsonos (override with HOTSONOS_UPLOAD_KEY_DIR).
       When the keystore is missing, Release falls back to the Android debug key. -->
  <PropertyGroup>
    <HotSonosUploadKeyDir Condition="'$(HOTSONOS_UPLOAD_KEY_DIR)' != ''">$(HOTSONOS_UPLOAD_KEY_DIR)</HotSonosUploadKeyDir>
    <HotSonosUploadKeyDir Condition="'$(HotSonosUploadKeyDir)' == ''">$(USERPROFILE)\.android-keys\hotsonos</HotSonosUploadKeyDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And Exists('$(HotSonosUploadKeyDir)\hotsonos-upload.keystore') And Exists('$(HotSonosUploadKeyDir)\hotsonos-upload.password')">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(HotSonosUploadKeyDir)\hotsonos-upload.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>hotsonos-upload</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>file:$(HotSonosUploadKeyDir)\hotsonos-upload.password</AndroidSigningStorePass>
    <AndroidSigningKeyPass>file:$(HotSonosUploadKeyDir)\hotsonos-upload.password</AndroidSigningKeyPass>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.5" Color="#1E232C" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E232C" BaseSize="192,192" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotSonos.Core\HotSonos.Core.csproj" />
    <ProjectReference Include="..\HotSonos.Remote.Protocol\HotSonos.Remote.Protocol.csproj" />
  </ItemGroup>

</Project>
