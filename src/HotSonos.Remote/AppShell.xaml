<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotSonos.Remote.AppShell"
             BackgroundColor="#12161C"
             Title="HotSonos">
    <Grid RowDefinitions="*,Auto">
        <ContentView x:Name="Body" />
        <Grid x:Name="MenuHost" Grid.RowSpan="2" IsVisible="False" ZIndex="20" />
        <Border x:Name="Toast" Grid.RowSpan="2" IsVisible="False"
                BackgroundColor="#1C2430" StrokeThickness="0"
                Padding="14,10" Margin="16,8"
                HorizontalOptions="Center" VerticalOptions="Start">
            <Label x:Name="ToastText" TextColor="#F4F7FB" FontSize="14" HorizontalTextAlignment="Center" />
        </Border>
        <ScrollView x:Name="TabScroll" Grid.Row="1" Orientation="Horizontal"
                    BackgroundColor="#1C2430" HorizontalScrollBarVisibility="Never">
            <Grid x:Name="TabHost">
                <HorizontalStackLayout x:Name="TabBar" Padding="4,6,4,10" Spacing="0" />
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
