<UserControl x:Class="HotSonos.App.Reports.ReportsHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,12,16,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Reports" FontSize="15" FontWeight="SemiBold"
                       Foreground="#FF1C2536" Margin="4,0,0,8" />
            <TextBlock x:Name="StorePathText" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                       FontSize="10" Foreground="#FF60707F" Margin="4,8,0,0" />
            <ListBox x:Name="ReportList" BorderBrush="#FFD8DEE4" Background="White"
                     SelectionChanged="ReportList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Blurb}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="#FF60707F" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ContentControl x:Name="ReportContent" Grid.Column="1" />
    </Grid>
</UserControl>
