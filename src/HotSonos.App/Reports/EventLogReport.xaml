<UserControl x:Class="HotSonos.App.Reports.EventLogReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Event Log" FontSize="15" FontWeight="SemiBold" Foreground="#FF1C2536" />
            <TextBlock Text="Music is track start, end, and skip. Sonos / system is speakers, groups, discovery, volume, hotkeys, and errors."
                       FontSize="11" Foreground="#FF60707F" Margin="0,2,0,8" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="CategoryCombo" Width="150" Height="28" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All" Tag="" IsSelected="True" />
                    <ComboBoxItem Content="Music" Tag="music" />
                    <ComboBoxItem Content="Sonos / system" Tag="sonos" />
                </ComboBox>
                <TextBlock Text="Kind" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox x:Name="KindCombo" Width="200" Height="28" SelectionChanged="Filter_Changed" />
                <Button Content="Refresh" Height="28" Padding="14,0" Margin="12,0,0,0" Click="Refresh_Click" />
                <Button x:Name="MoreButton" Content="Load older" Height="28" Padding="14,0" Margin="8,0,0,0"
                        Visibility="Collapsed" Click="More_Click" />
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="EventGrid" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF0F4F8" Background="White"
                  BorderBrush="#FFD8DEE4" BorderThickness="1" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding WhenLocal}" Width="130" />
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryLabel}" Width="80" />
                <DataGridTextColumn Header="Kind" Binding="{Binding KindLabel}" Width="150" />
                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,6,0,0" FontSize="11" Foreground="#FF60707F" />
    </Grid>
</UserControl>
