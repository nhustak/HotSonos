<Window x:Class="HotSonos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HotSonos"
        Width="1000" Height="700"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF4F6F8">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF1C2536" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style TargetType="TextBox" x:Key="HotkeyBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Width" Value="170" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Left vertical nav tabs -->
        <Style TargetType="TabItem">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,0"
                                Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE8F8EF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF2ECC71" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,0" />
                                <Setter Property="Foreground" Value="#FF1C8E54" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF0F4F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectionChanged="MainTabs_SelectionChanged">

            <!-- ========== Control ========== -->
            <TabItem x:Name="ControlTab" Header="Control">
                <!--
                  Row0 Auto: shuffle / level / now playing
                  Row1 Auto: speakers size to content (no empty stretch, no scrollbar unless constrained)
                  Row2 *: play list gets all leftover height; scrollbar only when items overflow
                -->
                <Grid Margin="16,12,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="340" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" MinWidth="280" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Background="#FFEAF8F0" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                    BorderBrush="#FF2ECC71" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🔀 Shuffle" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#FF1C2536" />
                                    <TextBlock Text="Pick All (Daily mix), a library folder, a tag, or a genre — then start. Folder mode stays in that folder for top-up."
                                               Foreground="#FF60707F" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                                        <ComboBox x:Name="ControlShuffleSourceCombo" Height="32" Width="220" MinWidth="160"
                                                  VerticalContentAlignment="Center" Margin="0,0,10,0"
                                                  SelectionChanged="ControlShuffleSourceCombo_SelectionChanged" />
                                        <Button x:Name="ControlShuffleStartButton"
                                                Content="🔀  Start shuffle now" Height="32" Padding="14,0" Margin="0,0,12,0"
                                                Background="#FF2ECC71" Foreground="White" FontWeight="SemiBold"
                                                Click="ShuffleLibraryButton_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="ControlShuffleFeedback"
                                               Text=""
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FF1C8E54" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <Separator Margin="0,12,0,10" Background="#FF2ECC71" Opacity="0.4" />
                                    <TextBlock Text="🔄 Restart fresh" FontSize="15" FontWeight="SemiBold" Foreground="#FF1C2536" />
                                    <TextBlock Text="Re-discover, regroup all speakers, and start a new shuffle."
                                               Foreground="#FF60707F" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ControlFreshStartButton"
                                                Content="🔄  Restart fresh now" Height="32" Padding="14,0" Margin="0,0,12,0"
                                                Background="#FF1C8E54" Foreground="White" FontWeight="SemiBold"
                                                Click="FreshStartButton_Click" />
                                    </StackPanel>
                                    <TextBlock Text="Global hotkeys for shuffle / restart / transport: Hotkeys tab."
                                               Foreground="#FF60707F" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Level all speakers" Style="{StaticResource SectionHeader}" Margin="0,4,0,6" />
                            <TextBlock Text="Set every speaker to the same house level and unmute. Per-room Offsets (Speakers list) are added for amp/Port calibration — e.g. level 20 + offset 60 → 80% on that room."
                                       Foreground="#FF60707F" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Level (%)" VerticalAlignment="Center" Width="80" />
                                <TextBox x:Name="LevelPercentBox" Width="50" Padding="6,4" VerticalContentAlignment="Center" />
                                <Button Content="Set all speakers now" Height="30" Padding="12,0" Margin="12,0,0,0"
                                        Background="#FF2ECC71" Foreground="White" FontWeight="SemiBold"
                                        Click="LevelVolumesButton_Click" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="#FFD8DEE4" Margin="0,4" HorizontalAlignment="Center" />

                        <StackPanel Grid.Column="2">
                            <Border Background="#FFF4F7FA" BorderBrush="#FFD8DEE4" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Now playing" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Width="72" Height="72" Margin="0,0,10,0"
                                                Background="#FFE8EEF2" CornerRadius="4" ClipToBounds="True">
                                            <Image x:Name="ControlNowPlayingArt"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="ControlNowPlayingTitle"
                                                       Text="Nothing playing"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Foreground="#FF1C2536" />
                                            <TextBlock x:Name="ControlNowPlayingArtist"
                                                       Text=""
                                                       FontSize="11" Margin="0,2,0,0"
                                                       TextWrapping="Wrap" Foreground="#FF60707F" />
                                            <TextBlock x:Name="ControlNowPlayingState"
                                                       Text=""
                                                       FontSize="11" Margin="0,4,0,0"
                                                       Foreground="#FF1C8E54" />
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Left">
                                        <Button Content="⏮" Width="36" Height="30" FontSize="14" Margin="0,0,6,0"
                                                Click="ControlTransportPrevious_Click"
                                                ToolTip="Previous track" />
                                        <Button x:Name="ControlTransportPlayPauseButton"
                                                Content="⏯" Width="44" Height="30" FontSize="14" Margin="0,0,6,0"
                                                FontWeight="SemiBold"
                                                Background="#FF2ECC71" Foreground="White"
                                                Click="ControlTransportPlayPause_Click"
                                                ToolTip="Play / Pause" />
                                        <Button Content="⏭" Width="36" Height="30" FontSize="14" Margin="0,0,6,0"
                                                Click="ControlTransportNext_Click"
                                                ToolTip="Next track" />
                                        <Button Content="🗑" Width="32" Height="30" FontSize="12" Margin="12,0,0,0"
                                                Click="ControlDeleteNowPlaying_Click"
                                                ToolTip="Delete current track from disk (Sonos + master when linked)" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Left">
                                        <Button Content="−" Width="36" Height="28" FontSize="16" Margin="0,0,6,0"
                                                Click="ControlTransportVolDown_Click"
                                                ToolTip="Volume down" />
                                        <Button Content="+" Width="36" Height="28" FontSize="16" Margin="0,0,6,0"
                                                Click="ControlTransportVolUp_Click"
                                                ToolTip="Volume up" />
                                        <Button Content="Mute" Height="28" Padding="10,0" Margin="0,0,6,0"
                                                Click="ControlTransportMute_Click"
                                                ToolTip="Mute toggle" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Target room / group" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                            <ComboBox x:Name="RoomComboBox" Height="28"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="RoomComboBox_SelectionChanged" />
                            <Button x:Name="RefreshButton" Content="Refresh devices" Height="28" Margin="0,8,0,0"
                                    Padding="10,0" Click="RefreshButton_Click" />
                            <TextBlock Text="Hotkeys control this room. Grouped rooms follow their coordinator."
                                       Foreground="#FF60707F" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- Speakers: height = content only (no star stretch / empty white space) -->
                    <Border Grid.Row="1" Margin="0,12,0,0" Background="White"
                            BorderBrush="#FFD8DEE4" BorderThickness="1" CornerRadius="6" Padding="12,8"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,2">
                                <Button DockPanel.Dock="Right" x:Name="RefreshVolumesButton"
                                        Content="Refresh volumes" Height="28" Padding="12,0" Margin="12,0,0,0"
                                        Click="RefreshVolumesButton_Click"
                                        ToolTip="Re-read mute/volume from every speaker (after Sonos app or hardware changes)" />
                                <TextBlock Text="Speakers" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Sliders = raw Sonos %. Offset is added only on Level all and Wake absolute levels."
                                       Foreground="#FF60707F" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
                            <StackPanel x:Name="SpeakersPanel" />
                        </StackPanel>
                    </Border>

                    <!-- Play list: all leftover height; scrollbar only when items don't fit -->
                    <Border Grid.Row="2" Margin="0,12,0,0" Background="White"
                            BorderBrush="#FFD8DEE4" BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Play folders, tags, genres &amp; Sonos playlists" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="ControlPlayListRefreshButton" Content="Refresh list" Height="28" Padding="12,0" Margin="12,0,0,0"
                                            Click="ControlPlayListRefresh_Click" />
                                </StackPanel>
                                <TextBlock x:Name="ControlPlayListStatus"
                                           Foreground="#FF60707F" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="" />
                            </StackPanel>
                            <ListBox x:Name="ControlPlayListBox"
                                     MaxWidth="520"
                                     HorizontalAlignment="Left"
                                     BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     HorizontalContentAlignment="Stretch"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0,1" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- One line per source — denser list, less scrolling -->
                                        <Border Background="#FFF4F7FA" BorderBrush="#FFE0E6EC" BorderThickness="1"
                                                CornerRadius="4" Padding="8,4" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#FFE8F8EF" CornerRadius="4"
                                                        Padding="6,1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#FF1C8E54" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                           FontSize="13" VerticalAlignment="Center" Margin="8,0,8,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Detail}" />
                                                <Button Grid.Column="2" Content="▶" Height="26" MinWidth="40"
                                                        Padding="8,0" VerticalAlignment="Center"
                                                        Background="#FF2ECC71" Foreground="White" FontWeight="SemiBold"
                                                        Tag="{Binding}"
                                                        ToolTip="Play"
                                                        Click="ControlPlayItem_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== Hotkeys ========== -->
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,8">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="All global hotkeys live here. Click a box and press your key combo. Esc clears."
                                   Foreground="#FF60707F" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />

                        <TextBlock Text="Library / house" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Shuffle library" VerticalAlignment="Center" Margin="0,4"
                                       ToolTip="Daily mix (All) → all speakers" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ShuffleHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Margin="0,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"
                                     ToolTip="Daily mix house shuffle (same as Control Start shuffle when From is All)" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="Shuffle"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Restart fresh" VerticalAlignment="Center" Margin="0,4"
                                       ToolTip="Re-discover, regroup, new shuffle" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="FreshStartHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Margin="0,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="FreshStart"
                                    Click="ClearHotkey_Click" />
                        </Grid>

                        <TextBlock Text="Transport" Style="{StaticResource SectionHeader}" Margin="0,12,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Play / Pause" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="PlayPauseHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Margin="0,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="PlayPause"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Next track" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NextHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Margin="0,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="Next"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Previous track" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="PreviousHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Margin="0,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="Previous"
                                    Click="ClearHotkey_Click" />
                        </Grid>

                        <TextBlock Text="Volume (all speakers)" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Volume up" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="VolumeUpHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="Auto" HorizontalAlignment="Left" Margin="0,4"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="VolumeUp"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Volume down" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="VolumeDownHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="Auto" HorizontalAlignment="Left" Margin="0,4"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="VolumeDown"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mute toggle" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="MuteHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="Auto" HorizontalAlignment="Left" Margin="0,4"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="Mute"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Level all" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="LevelVolumesHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="Auto" HorizontalAlignment="Left" Margin="0,4"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="3" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="LevelVolumes"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Quick tag overlay" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="QuickTagHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="Auto" HorizontalAlignment="Left" Margin="0,4"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"
                                     ToolTip="Opens preset picker for the playing library track (default Ctrl+Alt+T)" />
                            <Button Grid.Row="4" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="QuickTag"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Quick play overlay" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="QuickPlayHotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="Auto" HorizontalAlignment="Left" Margin="0,4"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus"
                                     ToolTip="Opens play picker: 1=library shuffle, 2–9=tags, genres &amp; Sonos playlists (default Ctrl+Alt+P)" />
                            <Button Grid.Row="5" Grid.Column="2" Content="Clear" Margin="8,4" Padding="8,0" Tag="QuickPlay"
                                    Click="ClearHotkey_Click" />
                            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Step per press (%)" VerticalAlignment="Center" Width="140" />
                                <TextBox x:Name="VolumeStepBox" Width="50" Padding="6,4" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Playlist / favorite slots" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Each slot: Sonos playlist/favorite, HotSonos tag, or library genre. Assign a hotkey — same as Control Play."
                                   Foreground="#FF60707F" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <Grid x:Name="FavoritesGrid" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="280" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Slot 1" VerticalAlignment="Center" Margin="0,4" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="Fav1NameCombo" Height="26" Margin="0,4"
                                      VerticalContentAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="2" x:Name="Fav1HotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="140" Margin="8,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="0" Grid.Column="3" Content="Clear" Margin="8,4" Padding="8,0" Tag="Fav1"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Slot 2" VerticalAlignment="Center" Margin="0,4" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="Fav2NameCombo" Height="26" Margin="0,4"
                                      VerticalContentAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="Fav2HotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="140" Margin="8,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="1" Grid.Column="3" Content="Clear" Margin="8,4" Padding="8,0" Tag="Fav2"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Slot 3" VerticalAlignment="Center" Margin="0,4" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Fav3NameCombo" Height="26" Margin="0,4"
                                      VerticalContentAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="2" x:Name="Fav3HotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="140" Margin="8,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="2" Grid.Column="3" Content="Clear" Margin="8,4" Padding="8,0" Tag="Fav3"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Slot 4" VerticalAlignment="Center" Margin="0,4" />
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="Fav4NameCombo" Height="26" Margin="0,4"
                                      VerticalContentAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="2" x:Name="Fav4HotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="140" Margin="8,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="3" Grid.Column="3" Content="Clear" Margin="8,4" Padding="8,0" Tag="Fav4"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Slot 5" VerticalAlignment="Center" Margin="0,4" />
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="Fav5NameCombo" Height="26" Margin="0,4"
                                      VerticalContentAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="2" x:Name="Fav5HotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="140" Margin="8,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="4" Grid.Column="3" Content="Clear" Margin="8,4" Padding="8,0" Tag="Fav5"
                                    Click="ClearHotkey_Click" />
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Slot 6" VerticalAlignment="Center" Margin="0,4" />
                            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="Fav6NameCombo" Height="26" Margin="0,4"
                                      VerticalContentAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="2" x:Name="Fav6HotkeyBox" Style="{StaticResource HotkeyBox}"
                                     Width="140" Margin="8,4" PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotFocus="HotkeyBox_GotFocus" />
                            <Button Grid.Row="5" Grid.Column="3" Content="Clear" Margin="8,4" Padding="8,0" Tag="Fav6"
                                    Click="ClearHotkey_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Shuffle ========== -->
            <TabItem Header="Shuffle">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,8">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Library shuffle &amp; history" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                        <TextBlock Text="History only affects the next rebuild or top-up — not the rest of the current queue. Played tracks are recorded while Sonos plays."
                                   Foreground="#FF60707F" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Queue size (shuffle)" VerticalAlignment="Center" Margin="0,6" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ShuffleQueueTracksBox" Padding="6,2" Margin="0,6"
                                     ToolTip="Tracks enqueued on each full shuffle (20–500)" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Top-up size" VerticalAlignment="Center" Margin="0,6" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ShuffleTopUpTracksBox" Padding="6,2" Margin="0,6"
                                     ToolTip="Tracks appended near end of queue (10–300)" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="History days" VerticalAlignment="Center" Margin="0,6" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ShuffleHistoryDaysBox" Padding="6,2" Margin="0,6"
                                     ToolTip="Exclude played tracks for this many days (1–90)" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Top-up when remaining ≤" VerticalAlignment="Center" Margin="0,6" />
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="ShuffleTopUpRemainingBox" Padding="6,2" Margin="0,6"
                                     ToolTip="Auto top-up when this many tracks or fewer remain (1–30)" />
                        </Grid>
                        <CheckBox x:Name="ShuffleExcludePlayedCheckBox" Content="Exclude recently played tracks from new batches" Margin="0,12,0,0" />
                        <CheckBox x:Name="ShuffleAutoTopUpCheckBox" Content="Auto top-up when the queue is nearly empty" Margin="0,6,0,0" />
                        <CheckBox x:Name="ContinueShuffleAfterSpecialPlayCheckBox"
                                  Content="After one track or tag queue (e.g. Favs), top-up into full library shuffle"
                                  Margin="0,6,0,0"
                                  ToolTip="Default on. When off, a one-shot or play_tag queue ends without appending house shuffle." />
                        <CheckBox x:Name="ShuffleArtistSpreadCheckBox" Content="Avoid same artist back-to-back when building a batch" Margin="0,6,0,0" />
                        <CheckBox x:Name="ShowGenresInPlaySourcesCheckBox"
                                  Content="Show genres in shuffle / play lists (Control, Quick Play, favorite slots)"
                                  Margin="0,12,0,0"
                                  ToolTip="Off for users who only want All + HotSonos tags + Sonos favorites. Genres come from standard file Genre tags." />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Clear play history" Height="30" Padding="14,0"
                                    Click="ClearPlayHistoryButton_Click" />
                            <TextBlock x:Name="PlayHistoryStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="#FF60707F" FontSize="11" Text="History: …" />
                        </StackPanel>
                        <TextBlock Text="Clearing history does not change the current Sonos queue — shuffle again to apply."
                                   Foreground="#FF60707F" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Library ========== -->
            <TabItem x:Name="LibraryTab" Header="Library">
                <Grid Margin="16,12,16,8" PreviewKeyDown="LibraryTab_PreviewKeyDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFEAF8F0" CornerRadius="6" Padding="12"
                            BorderBrush="#FF2ECC71" BorderThickness="1" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Local library cache" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="LibTabStatusText" Text="…" Foreground="#FF60707F" FontSize="12"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="LibraryStatusText" Foreground="#FF60707F" FontSize="11" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Discover from Sonos" Height="28" Padding="12,0"
                                        Click="DiscoverLibraryRootsButton_Click" />
                                <Button x:Name="LibraryRescanButton" Content="Rescan" Height="28" Padding="14,0" Margin="8,0,0,0"
                                        Click="LibraryRescanButton_Click" />
                                <Button Content="Force re-read tags" Height="28" Padding="12,0" Margin="8,0,0,0"
                                        Click="LibraryForceRescanButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Expander x:Name="LibraryPathsExpander" Grid.Row="1" Header="Library paths (Sonos share + master mappings)" Margin="0,0,0,10"
                              IsExpanded="False" HorizontalAlignment="Left" MaxWidth="520">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Music library folders"
                                       FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Text="Use Discover to pull folders from Sonos, or Add folder. Check Daily for every folder that should be in house shuffle (you can check more than one). Unchecked folders stay out of Daily."
                                       Foreground="#FF60707F" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" MaxWidth="520" />

                            <ListView x:Name="LibraryFoldersList" Width="520" Height="140" HorizontalAlignment="Left"
                                      BorderBrush="#FFD0D7DE" BorderThickness="1"
                                      SelectionMode="Extended"
                                      ToolTip="Select one or more rows, then Remove. Check Daily on as many folders as you want in the house mix.">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Daily" Width="44">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding InDaily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center"
                                                              ToolTip="Include in All / hotkey library shuffle" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="" Width="64">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="🔀" Height="24" MinWidth="36" Padding="4,0" FontSize="12"
                                                            Tag="{Binding}"
                                                            Click="LibraryFolderShuffle_Click"
                                                            ToolTip="History-aware shuffle of this folder only (top-up stays here)" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Folder" Width="100"
                                                        DisplayMemberBinding="{Binding DisplayName}" />
                                        <GridViewColumn Header="Path" Width="280"
                                                        DisplayMemberBinding="{Binding Path}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Add folder…" Height="28" Padding="12,0" Margin="0,0,8,0"
                                        Click="LibraryFolderAdd_Click"
                                        ToolTip="Browse for a music folder to include in the library list" />
                                <Button Content="Remove selected" Height="28" Padding="12,0"
                                        Click="LibraryFolderRemove_Click"
                                        ToolTip="Remove the selected folder(s) from this list" />
                            </StackPanel>

                            <TextBlock Text="Master mappings (optional)" FontWeight="SemiBold" Margin="0,14,0,4" />
                            <TextBlock Text="Link a hi-res master folder to a library folder for tag dual-write. Pick from the list — no path typing required."
                                       Foreground="#FF60707F" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" MaxWidth="520" />

                            <ListBox x:Name="MasterMappingsList" Width="520" Height="72" HorizontalAlignment="Left"
                                     BorderBrush="#FFD0D7DE" BorderThickness="1" Padding="2"
                                     SelectionChanged="MasterMappingsList_SelectionChanged"
                                     ToolTip="Select a row to edit, or remove it." />

                            <Grid Margin="0,8,0,0" Width="520" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Library folder" VerticalAlignment="Center"
                                           Margin="0,0,8,6" FontSize="12" />
                                <ComboBox x:Name="MasterMapSonosCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                          Height="28" Margin="0,0,0,6" IsEditable="False"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="Choose a library folder from the list above" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Master folder" VerticalAlignment="Center"
                                           Margin="0,0,8,6" FontSize="12" />
                                <TextBox x:Name="MasterMapMasterBox" Grid.Row="1" Grid.Column="1" Height="28"
                                         Margin="0,0,8,6" Padding="6,4" VerticalContentAlignment="Center"
                                         IsReadOnly="True"
                                         ToolTip="Hi-res archive root — use Browse" />
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Height="28" Padding="10,0"
                                        Margin="0,0,0,6" Click="MasterMapBrowseMaster_Click" />
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                                    <Button Content="Add / update" Height="28" Padding="12,0" Margin="0,0,8,0"
                                            Background="#FF2ECC71" Foreground="White" FontWeight="SemiBold"
                                            Click="MasterMapAddUpdate_Click" />
                                    <Button Content="Remove selected" Height="28" Padding="12,0"
                                            Click="MasterMapRemove_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- Label + field + actions grouped left — buttons stay by the box, not window-right -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Search" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="LibrarySearchBox" Height="30" MinWidth="280" Width="420" Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search all fields, or restrict: T:title · A:artist · TG:tag · F:format (one prefix at a time)"
                                 KeyDown="LibrarySearchBox_KeyDown" />
                        <Button Content="Go" Height="30" Padding="16,0" Margin="8,0,0,0"
                                Background="#FF2ECC71" Foreground="White" FontWeight="SemiBold"
                                Click="LibrarySearchButton_Click" />
                        <Button Content="Browse" Height="30" Padding="12,0" Margin="8,0,0,0"
                                Click="LibraryBrowseButton_Click" />
                    </StackPanel>

                    <!-- Flat tag catalog chips + busy banner -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                        <Border Background="#FFF4F7FA" BorderBrush="#FFD8DEE4" BorderThickness="1"
                                CornerRadius="6" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tags" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <WrapPanel x:Name="LibraryPresetButtonsHost" Orientation="Horizontal" />
                                </StackPanel>
                                <TextBlock x:Name="LibraryTempoActionFeedback" Grid.Row="0" Grid.Column="1"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontSize="11" Foreground="#FF1C8E54" FontWeight="SemiBold"
                                           MinWidth="80" TextAlignment="Right"
                                           Text="" />
                                <TextBlock x:Name="LibraryTempoSelectionHint" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Margin="0,6,0,0"
                                           Foreground="#FF60707F" FontSize="11" TextWrapping="Wrap"
                                           Text="Select a track — click chips (or keys 1–9) to toggle tags. Create/rename tags on the Tags tab." />
                            </Grid>
                        </Border>
                        <Border x:Name="LibraryBusyBanner" Visibility="Collapsed" Margin="0,8,0,0"
                                Background="#FFE8F8F0" BorderBrush="#FF2ECC71" BorderThickness="1"
                                CornerRadius="6" Padding="12,8">
                            <DockPanel>
                                <ProgressBar x:Name="LibraryBusyProgress" DockPanel.Dock="Left"
                                             Width="140" Height="14" Margin="0,0,12,0"
                                             IsIndeterminate="True" />
                                <TextBlock x:Name="LibraryBusyBannerText" VerticalAlignment="Center"
                                           FontWeight="SemiBold" FontSize="12" Foreground="#FF145A32"
                                           Text="Working…" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <DataGrid x:Name="LibraryResultsGrid" Grid.Row="4"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FFF0F4F8" Background="White"
                              BorderBrush="#FFD8DEE4" BorderThickness="1"
                              SelectionMode="Extended" FontSize="12"
                              SelectionChanged="LibraryResultsGrid_SelectionChanged">
                        <DataGrid.ContextMenu>
                            <ContextMenu Opened="LibraryContextMenu_Opened">
                                <MenuItem x:Name="LibraryApplyPresetMenu" Header="Toggle tag…" />
                                <Separator />
                                <MenuItem Header="Delete track(s) from disk…"
                                          Click="LibraryDeleteTracks_Click"
                                          Foreground="#FFB00020" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.6*" />
                            <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="1.2*" />
                            <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="1.2*" />
                            <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="1.4*" />
                            <DataGridTextColumn Header="Sonos" Binding="{Binding SonosOk}" Width="70" />
                            <DataGridTextColumn Header="Issue" Binding="{Binding Issue}" Width="1.2*" />
                            <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="1.6*" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path=Path}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="5" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox x:Name="LibraryUnplayableOnlyCheck" Content="Sonos-unplayable only"
                                      VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="Show unplayable" Height="26" Padding="10,0"
                                    Click="LibraryUnplayableButton_Click" />
                            <Button Content="Delete selected…" Height="26" Padding="10,0" Margin="12,0,0,0"
                                    Foreground="#FFB00020"
                                    Click="LibraryDeleteTracks_Click"
                                    ToolTip="Permanently delete selected files from the Sonos library share (and master twin when linked). Not a hotkey." />
                        </StackPanel>
                        <TextBlock x:Name="LibraryResultsMetaText" Foreground="#FF60707F" FontSize="11"
                                   Text="Search: free text, or T:title · A:artist · TG:tag · F:flac (one prefix). Tags chips toggle on selection." />
                        <TextBox x:Name="LibraryMcpResultBox" MinHeight="56" MaxHeight="120" Margin="0,6,0,0"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" Background="#FF1C2536" Foreground="#FFE8EEF4"
                                 Padding="8" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ========== Tags (catalog maintenance) ========== -->
            <TabItem x:Name="TagsTab" Header="Tags">
                <Grid Margin="16,12,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFEAF8F0" CornerRadius="6" Padding="12"
                            BorderBrush="#FF2ECC71" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Tag catalog" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0" Foreground="#FF60707F" FontSize="12" TextWrapping="Wrap"
                                       Text="Rename freely (files keep a hidden id). Order here is chip order and keys 1–9 in Library / Quick tag. Delete removes the tag from the catalog and from every track that has it." />
                        </StackPanel>
                    </Border>

                    <!-- Entry + actions grouped left (never stretch the box across the window) -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="New tag" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox x:Name="TagsNewLabelBox" Height="30" Width="280" MinWidth="180" Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 ToolTip="New tag label"
                                 KeyDown="TagsNewLabelBox_KeyDown" />
                        <Button Content="Add" Height="30" Padding="16,0" Margin="8,0,0,0"
                                Background="#FF2ECC71" Foreground="White" FontWeight="SemiBold"
                                Click="TagsAddButton_Click" />
                        <Button Content="Move up" Height="30" Padding="12,0" Margin="16,0,0,0"
                                Click="TagsMoveUpButton_Click" />
                        <Button Content="Move down" Height="30" Padding="12,0" Margin="6,0,0,0"
                                Click="TagsMoveDownButton_Click" />
                        <Button x:Name="TagsDeleteButton" Content="Delete" Height="30" Padding="12,0" Margin="6,0,0,0"
                                Click="TagsDeleteButton_Click" />
                    </StackPanel>

                    <DataGrid x:Name="TagsCatalogGrid" Grid.Row="2"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" SelectionMode="Single"
                              AlternatingRowBackground="#FFF0F4F8" Background="White"
                              BorderBrush="#FFD8DEE4" BorderThickness="1" FontSize="13"
                              SelectionChanged="TagsCatalogGrid_SelectionChanged"
                              CellEditEnding="TagsCatalogGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="44" IsReadOnly="True" />
                            <DataGridTextColumn Header="Label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                               Width="*" />
                            <DataGridTextColumn Header="Hotkey" Binding="{Binding HotkeyHint}" Width="70" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock x:Name="TagsCatalogStatusText" Foreground="#FF60707F" FontSize="12"
                                   TextWrapping="Wrap"
                                   Text="Select a row to reorder or delete. Double-click Label to rename (saved on commit)." />
                        <TextBlock Margin="0,6,0,0" Foreground="#FF90A0B0" FontSize="11" TextWrapping="Wrap"
                                   Text="Delete strips the tag from all library files that have it (locked/playing files are queued). Needs write access to the Sonos share." />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ========== Wake ========== -->
            <TabItem Header="Wake">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,8">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Wake to music" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                        <CheckBox x:Name="WakeEnabledCheckBox" Content="Enable wake to music" Margin="0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Time" VerticalAlignment="Center" Width="70" />
                            <TextBox x:Name="WakeTimeBox" Width="60" Padding="6,2" VerticalContentAlignment="Center" />
                            <TextBlock Text="(24-hour, e.g. 07:00)" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="#FF60707F" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Days" VerticalAlignment="Center" Width="70" />
                            <CheckBox x:Name="WakeDaySu" Content="Su" Margin="0,0,8,0" />
                            <CheckBox x:Name="WakeDayMo" Content="Mo" Margin="0,0,8,0" />
                            <CheckBox x:Name="WakeDayTu" Content="Tu" Margin="0,0,8,0" />
                            <CheckBox x:Name="WakeDayWe" Content="We" Margin="0,0,8,0" />
                            <CheckBox x:Name="WakeDayTh" Content="Th" Margin="0,0,8,0" />
                            <CheckBox x:Name="WakeDayFr" Content="Fr" Margin="0,0,8,0" />
                            <CheckBox x:Name="WakeDaySa" Content="Sa" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Room" VerticalAlignment="Center" Width="70" />
                            <ComboBox x:Name="WakeRoomComboBox" Width="240" Height="28" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Play" VerticalAlignment="Center" Width="70" />
                            <ComboBox x:Name="WakeSourceComboBox" Width="240" Height="28" VerticalContentAlignment="Center"
                                      SelectionChanged="WakeSourceComboBox_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Favorite" VerticalAlignment="Center" Width="70" />
                            <ComboBox x:Name="WakeFavoriteComboBox" Width="240" Height="28" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start %" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="WakeStartVolumeBox" Padding="6,2" Margin="0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="End %" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="0" Grid.Column="4" x:Name="WakeEndVolumeBox" Padding="6,2" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Step %" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="WakeStepBox" Padding="6,2" Margin="0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="Every min" VerticalAlignment="Center" Margin="0,4" />
                            <TextBox Grid.Row="1" Grid.Column="4" x:Name="WakeIntervalBox" Padding="6,2" Margin="0,4" />
                        </Grid>
                        <CheckBox x:Name="WakeExpandCheckBox"
                                  Content="After ramp: expand to all speakers and shuffle library"
                                  Margin="0,10,0,0" />
                        <TextBlock Text="PC must be awake with HotSonos running. Skipped if Sonos is already playing."
                                   Foreground="#FF60707F" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Options ========== -->
            <TabItem Header="Options">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,16,8">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Now-Playing flyout" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                        <CheckBox x:Name="FlyoutOnTrackChangeCheckBox" Content="Pop the flyout on every track change" Margin="0,2" />
                        <CheckBox x:Name="FlyoutOnActionCheckBox" Content="Pop the flyout when I use a hotkey or action" Margin="0,6" />
                        <TextBlock Text="Drag the flyout to reposition; pin to keep it on-screen."
                                   Foreground="#FF60707F" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="System tray" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Double-click the tray icon to:" VerticalAlignment="Center" Margin="0,0,0,6" />
                        <ComboBox x:Name="TrayDoubleClickCombo" Height="28" Width="320" HorizontalAlignment="Left"
                                  VerticalContentAlignment="Center" />
                        <TextBlock Text="Right-click still opens the full tray menu."
                                   Foreground="#FF60707F" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <TextBlock Text="Startup &amp; nightly" Style="{StaticResource SectionHeader}" />
                        <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start HotSonos with Windows" Margin="0,2"
                                  Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <CheckBox x:Name="NightlyResetCheckBox" Content="Re-sync all speakers nightly at" VerticalAlignment="Center" />
                            <TextBox x:Name="NightlyResetTimeBox" Width="60" Margin="8,0,0,0" Padding="6,2"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Text="(24-hour)" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="#FF60707F" FontSize="11" />
                        </StackPanel>
                        <CheckBox x:Name="NightlyResetReshuffleCheckBox" Content="Also reshuffle the library (starts playback)" Margin="20,6,0,0" />

                        <TextBlock Text="Agent MCP (loopback)" Style="{StaticResource SectionHeader}" />
                        <CheckBox x:Name="McpEnabledCheckBox" Content="Enable MCP server while HotSonos is running" Margin="0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="Port" VerticalAlignment="Center" Width="50" />
                            <TextBox x:Name="McpPortBox" Width="80" Padding="6,2" VerticalContentAlignment="Center" />
                            <TextBlock Text="(restart app after port change)"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#FF60707F" FontSize="11" />
                        </StackPanel>
                        <TextBlock Text="http://127.0.0.1:port/mcp — loopback only."
                                   Foreground="#FF60707F" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== Topology monitor (rooms / Sub / Port in-out) ========== -->
            <TabItem x:Name="TopologyTab" Header="Topology">
                <Grid Margin="16,12,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="120" />
                        <RowDefinition Height="90" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFEEF2F7" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                            BorderBrush="#FFC5D0DC" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Speaker / Sub / Port map" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <CheckBox x:Name="TopologyMonitorEnabledCheck" Content="Monitor ON"
                                          VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold"
                                          ToolTip="When OFF (default): no bonded-Sub parse, no event log spam, no map diffs on every Sonos push. Turn ON only to debug group flaps."
                                          Checked="TopologyMonitorEnabledCheck_Changed"
                                          Unchecked="TopologyMonitorEnabledCheck_Changed" />
                                <CheckBox x:Name="TopologyAutoScrollCheck" Content="Auto-scroll events" IsChecked="True"
                                          VerticalAlignment="Center" Margin="12,0,0,0" />
                                <Button Content="Refresh now" Height="28" Padding="12,0" Margin="12,0,0,0"
                                        Click="TopologyRefresh_Click"
                                        ToolTip="Pull topology from Sonos and redraw map (requires Monitor ON for full map)" />
                                <Button x:Name="TopologyRegroupButton" Content="Regroup all" Height="28" Padding="12,0" Margin="8,0,0,0"
                                        Background="#FF2ECC71" Foreground="White" FontWeight="SemiBold"
                                        Click="TopologyRegroup_Click"
                                        ToolTip="Pull every speaker into the active group (does not restart shuffle)" />
                                <Button Content="Open log file" Height="28" Padding="12,0" Margin="8,0,0,0"
                                        Click="TopologyOpenLog_Click" />
                            </StackPanel>
                            <TextBlock x:Name="TopologySummaryText" Text="Monitor OFF — not logging topology events (system stays light)."
                                       Foreground="#FF1C2536" FontSize="12" Margin="0,8,0,4" TextWrapping="Wrap"
                                       FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Border Background="#FFE8F8EF" BorderBrush="#FF2ECC71" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Green = main/playing group" FontSize="10" Foreground="#FF1C8E54" />
                                </Border>
                                <Border Background="#FFFFF4E5" BorderBrush="#FFE6A23C" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Amber = solo / not in house" FontSize="10" Foreground="#FFB8821A" />
                                </Border>
                                <Border Background="#FFFDECEC" BorderBrush="#FFE74C3C" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Red = offline / vanished" FontSize="10" Foreground="#FFC0392B" />
                                </Border>
                                <Border Background="#FFE8EEF8" BorderBrush="#FF5B7C99" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Blue chip = Sub / bonded" FontSize="10" Foreground="#FF3D5A80" />
                                </Border>
                                <Border Background="#FFF3E8FA" BorderBrush="#FF9B59B6" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="Purple chip = Port / Theater" FontSize="10" Foreground="#FF7D3C98" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Graphical group map -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#FFD8DEE4" BorderThickness="1"
                            CornerRadius="6" Margin="0,0,0,8" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="TopologyMapPanel" Orientation="Horizontal" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock Grid.Row="2" Text="Event trail (newest at bottom)" FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <ListBox x:Name="TopologyEventList" Grid.Row="3"
                             BorderBrush="#FFD8DEE4" BorderThickness="1" Background="White"
                             FontFamily="Consolas" FontSize="11"
                             SelectionChanged="TopologyEventList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HeaderLine}" TextWrapping="Wrap" Margin="2,1"
                                           Foreground="#FF1C2536" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GroupBox Grid.Row="4" Header="Selected event" Margin="0,6,0,0" Padding="4">
                        <TextBox x:Name="TopologyDetailBox" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" BorderThickness="0"
                                 Background="Transparent" />
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ========== MCP Debug ========== -->
            <TabItem x:Name="McpTab" Header="MCP Debug">
                <Grid Margin="16,12,16,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="160" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFEEF2F7" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                            BorderBrush="#FFC5D0DC" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="MCP command log" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <CheckBox x:Name="McpAutoScrollCheck" Content="Auto-scroll" IsChecked="True"
                                          VerticalAlignment="Center" Margin="16,0,0,0" />
                                <Button Content="Clear" Height="28" Padding="12,0" Margin="12,0,0,0"
                                        Click="McpClearLog_Click" />
                                <Button Content="Copy endpoint" Height="28" Padding="12,0" Margin="8,0,0,0"
                                        Click="McpCopyEndpoint_Click" />
                            </StackPanel>
                            <TextBlock x:Name="McpEndpointText" Text="Endpoint: (not running)"
                                       Foreground="#FF60707F" FontSize="12" Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="McpActivityList" Grid.Row="1"
                             BorderBrush="#FFD8DEE4" BorderThickness="1" Background="White"
                             FontFamily="Consolas" FontSize="12"
                             SelectionChanged="McpActivityList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding HeaderLine}" FontWeight="SemiBold"
                                               Foreground="#FF1C2536" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ResultSummary}" Foreground="#FF60707F"
                                               TextWrapping="Wrap" FontSize="11" Margin="0,1,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GroupBox Grid.Row="2" Header="Selected call detail" Margin="0,8,0,0" Padding="6">
                        <TextBox x:Name="McpDetailBox" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11" BorderThickness="0"
                                 Background="Transparent" />
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#FFEEF2F7" BorderBrush="#FFD8DEE4" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="#FF2E7D46" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="Hide to tray" Height="30" Padding="14,0" Margin="0,0,8,0"
                        Click="HideButton_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="Save" Height="30" Padding="20,0"
                        Background="#FF2ECC71" Foreground="White" FontWeight="SemiBold"
                        Click="SaveButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
