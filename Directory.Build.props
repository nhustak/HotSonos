<Project>

  <!--
    Single source of truth for the product version. All projects (app, core,
    harness, and the WiX installer via $(Version)) inherit it. Local/dev builds
    use the value below; CI release builds override it from the git tag with
    -p:Version=x.y.z, so the app exe and the MSI always carry the same version.
  -->
  <PropertyGroup>
    <!-- Isolation ladder on crash1: 1.0.0.59-#  (# = last isolation item applied).
         A trailing .P marks a non-ladder patch on top of rung #, so ladder numbering
         stays intact (this is NOT rung 7 — that rung is still poll 5s→10s). -->
    <Version>1.0.0.59-6.15</Version>
    <!-- Assembly/FileVersion must be 4 numeric parts; map 59-N.P → 1.0.59.N0P -->
    <AssemblyVersion>1.0.59.615</AssemblyVersion>
    <FileVersion>1.0.59.615</FileVersion>
    <!-- Keep InformationalVersion exactly equal to $(Version) (no +commit suffix),
         since the app displays it. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
