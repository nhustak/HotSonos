<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotSonos.Remote.AppShell"
             BackgroundColor="#12161C"
             Title="HotSonos">
    <Grid RowDefinitions="*,Auto">
        <ContentView x:Name="Body" />
        <ScrollView x:Name="TabScroll" Grid.Row="1" Orientation="Horizontal"
                    BackgroundColor="#1C2430" HorizontalScrollBarVisibility="Never">
            <Grid x:Name="TabHost">
                <HorizontalStackLayout x:Name="TabBar" Padding="4,6,4,10" Spacing="0" />
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
