<Window x:Class="HotSonos.App.Windows.QuickPlayOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HotSonos Quick Play"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">
    <Border Background="#F0141C28" BorderBrush="#FF2ECC71" BorderThickness="2" CornerRadius="12" Padding="18,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#FF000000" />
        </Border.Effect>
        <StackPanel MinWidth="400" MaxWidth="520">
            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                <TextBlock Text="Quick play" FontSize="18" FontWeight="SemiBold" Foreground="#FFE8EEF4"
                           DockPanel.Dock="Left" />
                <TextBlock Text="Esc close" FontSize="11" Foreground="#FF708090"
                           DockPanel.Dock="Right" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock FontSize="12" Foreground="#FF90A0B0" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="1 = full library shuffle · 2–9 = tags &amp; Sonos playlists · click or digit" />
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#FF2ECC71" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="Collapsed" FontWeight="SemiBold" />
            <ItemsControl x:Name="SourceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,3" Padding="10,8" Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Background="{Binding RowBackground}"
                                BorderBrush="{Binding RowBorder}"
                                BorderThickness="1"
                                Click="SourceButton_Click"
                                Tag="{Binding Slot}"
                                ToolTip="{Binding Detail}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF2ECC71" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF1A5C3A" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Slot}" FontSize="18" FontWeight="Bold"
                                           Foreground="#FF2ECC71" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF7DCEA0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#FFE8EEF4" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#FF90A0B0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
